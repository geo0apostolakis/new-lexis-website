# Booking + contact forms email newlexis@outlook.com through Resend.
# Without this key the forms open the visitor's own email app instead (nothing is lost).
RESEND_API_KEY=
# Sender address. onboarding@resend.dev only delivers to the Resend account's own email,
# so either sign up to Resend with newlexis@outlook.com or verify a domain and set this.
MAIL_FROM=New Lexis Website <onboarding@resend.dev>
# Optional: send form emails somewhere other than newlexis@outlook.com
MAIL_TO=
